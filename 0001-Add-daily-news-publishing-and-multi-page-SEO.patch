+function Youtube(){const videos=[['HbhiMTXHWaE','ऐतिहासिक धामारी गाव'],['7Puxzof00yg','वाघेश्वर मंदिर आणि बारव'],['PamFxBgRPSI','धामारी नगरकोट']];return <Layout><PageHero eyebrow="YouTube" title="धामारीचे व्हिडिओ" lede="माहितीपट आणि क्षेत्रभेटींचे स्वतंत्र व्हिडिओ पान—मुख्य पानावर कोणताही YouTube प्लेअर लोड होत नाही."/><section className="socialWall pageSection"><div className="shell"><div className="videoGrid">{videos.map(([id,title])=><article key={id}><div className="videoFrame"><iframe src={`https://www.youtube-nocookie.com/embed/${id}`} title={title} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowFullScreen></iframe></div><b>{title}</b><span>मूळ व्हिडिओ संबंधित YouTube प्रकाशकाकडे होस्ट आहे</span></article>)}</div></div></section></Layout>}
+
+function Sources(){return <section className="sources"><div className="shell"><p className="sectionNo">०५ / स्रोत नोंदणी</p><div className="sourceHead"><h2>नोंदी स्वतः<br/>वाचा.</h2><p>शासकीय, संस्थात्मक आणि प्रकाशित स्रोतांच्या थेट नोंदी.</p></div><div className="sourceList">{sources.map(([title,publisher,url],i)=><a href={url} target="_blank" rel="noreferrer" key={url}><span>{String(i+1).padStart(2,"0")}</span><div><b>{title}</b><small>{publisher}</small></div><i>↗</i></a>)}</div></div></section>}
