+function LatestNews(){const automated=(internetUpdates as InternetUpdate[]).filter(item=>!curatedNews.some(curated=>{const automatedTitle=newsKey(item.title),curatedTitle=newsKey(curated.title);return automatedTitle.includes(curatedTitle)||curatedTitle.includes(automatedTitle)}));return <Layout><PageHero eyebrow="अद्ययावत नोंदी" title="धामारीच्या ताज्या बातम्या" lede="संदर्भासह निवडक वृत्ते आणि दररोजच्या स्वयंचलित शोधातून मिळालेले नवीन दुवे."/><section className="blog pageSection"><div className="shell"><div className="newsGrid">{curatedNews.map(item=><article className="newsCard" key={item.url}><p className="blogMeta"><span>{item.category}</span>{item.date}</p><h2>{item.title}</h2><p>{item.summary}</p><small>{item.source} · {item.status}</small><a href={item.url} target="_blank" rel="noreferrer">मूळ स्रोत वाचा →</a></article>)}</div>{automated.length>0?<><h2 className="mediaSubhead">स्वयंचलित शोधातील नवीन दुवे</h2><p className="caveat">खालील दुवे स्वयंचलितरीत्या मिळाले आहेत. ते पडताळलेले तथ्य समजू नयेत.</p><div className="newsGrid">{automated.map(item=><article className="newsCard" key={item.id}><p className="blogMeta"><span>पडताळणी प्रलंबित</span>{new Date(item.publishedAt).toLocaleDateString("mr-IN")}</p><h2>{item.title}</h2><small>{item.source}</small><a href={item.sourceUrl} target="_blank" rel="noreferrer">प्रकाशकाची नोंद उघडा →</a></article>)}</div></>:<p className="emptyState">आजच्या स्वयंचलित शोधात नवीन वेगळी नोंद साठवलेली नाही.</p>}</div></section></Layout>}
