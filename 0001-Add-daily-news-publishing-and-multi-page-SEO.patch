+function History(){return <Layout><PageHero eyebrow="पुराव्याधारित कालरेषा" title="धामारीचा इतिहास" lede="दस्तऐवजीकृत नोंदी, प्रकाशित अभ्यास आणि स्पष्टपणे ओळख दिलेली लोकस्मृती."/><section className="history pageSection"><div className="shell">{historyEntries.map(x=><article className="event" key={x.era+x.title}><p className="era">{x.era}</p><div><span className={`badge ${x.status==="दस्तऐवजीकृत"?"verified":x.status==="नवीनतम वृत्त"?"current":""}`}>{x.status}</span><h2>{x.title}</h2><p className="mr">{x.mr}</p><p>{x.text}</p></div></article>)}</div></section></Layout>}
